{
  "project": "FleetMind-LLM",
  "version": "v1",
  "source": "https://huggingface.co/datasets/yogape/logistics-operations",
  "source_type": "synthetic",
  "seed": 42,
  "clean_business_records": 84776,
  "selected_business_records": {
    "train": 800,
    "validation": 100,
    "test": 100
  },
  "instruction_counts": {
    "train": 1600,
    "validation": 200,
    "test": 200
  },
  "task_A_fields": [
    "load_id",
    "truck_id",
    "origin_city",
    "destination_city",
    "revenue_usd",
    "fuel_used_gallons",
    "scheduled_delivery",
    "actual_delivery"
  ],
  "task_A_omission_rate": 0.25,
  "task_A_missing_value": null,
  "task_B_rule": {
    "delayed": "actual_delivery > scheduled_delivery",
    "on_time": "actual_delivery <= scheduled_delivery"
  },
  "currency": "USD",
  "fuel_unit": "gallons",
  "system_prompt": "你是物流业务数据助手。只依据用户提供的记录完成任务，不编造信息。只输出合法 JSON，不添加解释或 Markdown 代码围栏。",
  "task_A_instruction": "提取以下字段：load_id, truck_id, origin_city, destination_city, revenue_usd, fuel_used_gallons, scheduled_delivery, actual_delivery。编号、城市和时间使用字符串，收入与耗油量使用数字。时间保留原格式。输入未提供的信息填 null，不要推测。\n\n",
  "task_B_instruction": "判断记录是否发生交付延误。所有时间使用同一时间口径。实际交付时间晚于计划时间标为 delayed，否则标为 on_time。只输出 {\"delay_label\": \"标签\"}。\n\n",
  "task_A_templates": {
    "train": [
      "运输记录如下：{details}",
      "本趟业务登记：{details}",
      "请处理以下运输交接信息：{details}",
      "收到一份运输业务摘要：{details}"
    ],
    "validation": [
      "以下是待录入系统的运输资料：{details}",
      "请整理这份业务登记内容：{details}"
    ],
    "test": [
      "运营人员提供了如下运输说明：{details}",
      "请从这份运输情况记录中读取信息：{details}"
    ]
  },
  "task_B_templates": {
    "train": [
      "计划交付时间：{scheduled}；实际交付时间：{actual}。",
      "这趟运输原定于{scheduled}交付，实际于{actual}交付。",
      "交付登记：实际时间为{actual}，计划时间为{scheduled}。",
      "请核对交付记录：计划{scheduled}，实际{actual}。"
    ],
    "validation": [
      "交付记录列明：原计划{scheduled}；实际完成于{actual}。",
      "请比较本次交付时间：实际为{actual}；约定计划为{scheduled}。"
    ],
    "test": [
      "运营记录记载，计划交付为{scheduled}，实际交付为{actual}。",
      "本次交付已完成于{actual}，对应计划交付时刻为{scheduled}。"
    ]
  },
